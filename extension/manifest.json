{
  "manifest_version": 3,
  "name": "fork-scout",
  "version": "0.1.0",
  "description": "Find the forks of a GitHub repo worth copying, with a safety scan. Works with no setup; GitHub token and AI review are optional.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["scanlib.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["rules.json"], "matches": ["https://github.com/*"] }],
  "options_page": "options.html"
}
